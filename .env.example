# Copy to .env and edit:  cp .env.example .env
# `npm start`, `npm run dev` and `docker compose` all read it. .env is git-ignored; this example is committed.

# Password for the web UI. REQUIRED if anything beyond a trusted network can reach the app.
# Quotes, backslashes and newlines are not allowed. Generate one:  openssl rand -base64 24 | tr -dc A-Za-z0-9
APP_PASSWORD=

# Port the app listens on (docker-compose maps host 3000 -> container 3000).
PORT=3000

# Time zone for "today", daily reminders and recurring items.
TZ=Europe/Copenhagen

# Contact address sent to browser push services (Apple validates it). Use a real one.
VAPID_SUBJECT=atharv@vadehra.me

# SQLite database file. (Inside Docker this is fixed to /data/budget.db by the image.)
DB_PATH=./data/budget.db

# Behind a reverse proxy (Caddy, Traefik, tailscale serve)? Uncomment so login throttling sees real client IPs.
# TRUST_PROXY=1
# Behind a Cloudflare Tunnel? Use this instead: the client IP is taken from CF-Connecting-IP (X-Forwarded-For is ignored).
# TRUST_PROXY=cloudflare

# Address to listen on. Default 0.0.0.0 (all interfaces). With a tunnel use 127.0.0.1 so only cloudflared can reach the app.
# HOST=127.0.0.1

# Only answer to these Host names (DNS-rebinding defence). Loopback is always allowed. Include the IP if you browse by IP.
# ALLOWED_HOSTS=budget.example.com,192.168.1.50

# Tests and air-gapped installs: never call the exchange-rate APIs (set a manual rate in the app instead).
# NO_NETWORK=1
